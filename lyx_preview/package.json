{
  "name": "lyx-preview",
  "displayName": "LyX Preview",
  "description": "Read-only preview of saved .lyx files.",
  "version": "0.1.8",
  "publisher": "CoconutWater",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/naivej/lq.git"
  },
  "homepage": "https://github.com/naivej/lq/tree/main/lyx_preview",
  "icon": "media/LYX_preview_S.png",
  "engines": {
    "vscode": "^1.96.0"
  },

  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.lyx"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lyx",
        "aliases": [
          "LyX",
          "lyx"
        ],
        "extensions": [
          ".lyx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "lyxPreview.live",
        "displayName": "LyX",
        "selector": [{ "filenamePattern": "*.lyx" }],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "lyx-preview.open",
        "title": "Open LyX Preview",
        "shortTitle": "LyX Preview",
        "icon": {
          "light": "media/L-L.svg",
          "dark": "media/L-L.svg"
        },
        "category": "LyX Preview"
      },
      {
        "command": "lyx-preview.openInLyx",
        "title": "Open in LyX",
        "icon": {
          "light": "media/L-Open.svg",
          "dark": "media/L-Open-dark.svg"
        },
        "category": "LyX Preview"
      },
      {
        "command": "lyx-preview.revealOutline",
        "title": "Reveal in Preview",
        "category": "LyX Preview"
      },
      {
        "command": "lyx-preview.viewOriginal",
        "title": "Original",
        "category": "LyX Preview"
      },
      {
        "command": "lyx-preview.viewTracked",
        "title": "Tracked",
        "category": "LyX Preview"
      },
      {
        "command": "lyx-preview.viewClean",
        "title": "Clean",
        "category": "LyX Preview"
      },
      {
        "command": "lyx-preview.changeView",
        "title": "Tracked-change view",
        "category": "LyX Preview"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "lyxPreview.outline",
          "name": "LyX Outline",
          "when": "lyxPreview.hasOutline || resourceExtname == .lyx",
          "contextualTitle": "LyX Outline",
          "icon": "media/L-L.svg"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "lyx-preview.openInLyx",
          "when": "(resourceExtname == .lyx && !isInDiffEditor) || activeCustomEditorId == 'lyxPreview.live'",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "lyx-preview.openInLyx",
          "when": "resourceExtname == .lyx || activeCustomEditorId == 'lyxPreview.live'"
        },
        {
          "command": "lyx-preview.open",
          "when": "resourceExtname == .lyx"
        },
        {
          "command": "lyx-preview.revealOutline",
          "when": "false"
        },
        {
          "command": "lyx-preview.changeView",
          "when": "false"
        },
        {
          "command": "lyx-preview.viewOriginal",
          "when": "false"
        },
        {
          "command": "lyx-preview.viewTracked",
          "when": "false"
        },
        {
          "command": "lyx-preview.viewClean",
          "when": "false"
        },
        {
          "command": "lyx-preview.changeView",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "LyX Preview",
      "properties": {
        "lyx-preview.lyxPath": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "Path to the LyX application to open documents in. Leave empty to find an installed LyX automatically. Accepts ~; on macOS, accepts LyX.app."
        },
        "lyx-preview.lqPath": {
          "type": "string",
          "default": "",
          "description": "Path of the lq binary to use second, when lyx-preview.unmanagedLqPath is empty. Downloaded and updated from GitHub."
        },
        "lyx-preview.unmanagedLqPath": {
          "type": "string",
          "default": "",
          "description": "Path of the lq binary to use first. Never downloaded or overwritten."
        },
        "lyx-preview.timeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "How long to wait for the preview, in milliseconds."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint .",
    "test": "npm run compile && node --test out/fsPath.test.js out/previewSession.test.js out/outlineProvider.test.js out/lqRunner.test.js out/lqEnsure.test.js out/webview.test.js out/liveSelection.test.js out/previewRoster.test.js out/previewPanels.test.js out/lyxOpen.test.js out/extensionHost.test.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/vscode": "~1.96.0",
    "@vscode/vsce": "^3.7.0",
    "eslint": "^10.8.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "qs": ">=6.16.0"
  }
}
