# What WILL be in the .vsix (everything not matched below):
#   package.json
#   README.md
#   language-configuration.json
#   media/**          (icons: LYX_preview_S.png, L-L.svg, L-Open*.svg)
#   out/**/*.js       (compiled extension; tests excluded below)
#   LICENSE / CHANGELOG.md when present
#
# What NOT to put in the .vsix (glob patterns).
# vsce exclusions come from this file; a broad !out/** would also re-include
# tests and source maps, so compiled production JS uses the default inclusion.

# Unused media (kept as design sources)
media/L-L-Y.svg
media/L-S.png
media/LYX_preview_L.png
media/X-L.svg
media/X-S.png
media/Y-L.svg
media/Y-S.png

# Sources & tooling (runtime loads out/extension.js, not TypeScript)
src/**
**/*.ts
**/*.map
tsconfig.json
eslint.config.mjs
.gitignore

# Tests (compiled next to production JS under out/)
**/*.test.js

# Dev install / local artifacts
node_modules/**
package-lock.json
*.vsix
dist/**
